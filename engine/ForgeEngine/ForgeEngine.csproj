<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Managed-only host — NO PicoGK reference here (docs/04 §2). PicoGK.dll and forge-sandbox.dll are read
         as Roslyn metadata references from the sandbox folder at runtime, never loaded. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>forge-engine</AssemblyName>
    <RootNamespace>ForgeEngine</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>All</AnalysisMode>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn for in-memory compilation (DesignCompiler.cs, Analyzers.cs). System.Text.Json ships with net9.0. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForgeEngine.Tests" />
    <None Include="..\picogk_api.json" Link="picogk_api.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

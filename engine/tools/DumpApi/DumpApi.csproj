<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- DumpApi: reflection walker over PicoGK.dll (+ optional forge-sandbox.dll for PicoForge.Kit) → picogk_api.json -->
    <!-- Output drives Roslyn analyzer + LLM prompt API card -->
    <!-- DECISION (devlog 2026-11-25): references the PicoGK package directly instead of ForgeSandbox so the
         API truth can be generated before (and independently of) the sandbox compiling. Kit is reflected
         from the forge-sandbox.dll path given as the second argument. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dump-api</AssemblyName>
    <RootNamespace>DumpApi</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PicoGK" Version="2.2.*" />
  </ItemGroup>
</Project>
